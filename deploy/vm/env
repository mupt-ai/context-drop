# Server settings; deploy.sh appends CONTEXT_DROP_ADMIN_TOKEN from Secret Manager.
CONTEXT_DROP_ADDR=127.0.0.1:8080
CONTEXT_DROP_BASE_URL=https://contextdrop.dev
CONTEXT_DROP_STORAGE=gcs
CONTEXT_DROP_GCS_BUCKET=context-drop-prod
CONTEXT_DROP_DEFAULT_TTL=24h
CONTEXT_DROP_MAX_TTL=168h
CONTEXT_DROP_MAX_BYTES=26214400
CONTEXT_DROP_PROXY_HOPS=1
CONTEXT_DROP_DATA_DIR=/var/lib/context-drop
CONTEXT_DROP_ORG_STATE=/var/lib/context-drop/orgs.db
CONTEXT_DROP_DENO=/usr/local/bin/deno
CONTEXT_DROP_MODS_DIR=/var/lib/context-drop/mods

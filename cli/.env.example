# context-drop server env
# Copy to .env.local for local use. Do not commit real credentials.

CONTEXT_DROP_UPLOAD_TOKEN=replace-with-a-long-random-secret
CONTEXT_DROP_STORAGE=local
CONTEXT_DROP_DATA_DIR=.data
CONTEXT_DROP_BASE_URL=http://localhost:8080
CONTEXT_DROP_ADDR=:8080

# To use GCS instead, set CONTEXT_DROP_STORAGE=gcs and provide your own
# CONTEXT_DROP_GCS_BUCKET and Google Cloud credentials.

# context-drop server env
# Copy to .env.local for local use. Do not commit real credentials.

CONTEXT_DROP_STORAGE=gcs
CONTEXT_DROP_GCS_BUCKET=context-drop-prod
CONTEXT_DROP_BASE_URL=https://contextdrop.dev
CONTEXT_DROP_ADDR=:8080
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json

# For local filesystem testing, omit CONTEXT_DROP_STORAGE or set it to local:
# CONTEXT_DROP_STORAGE=local
# CONTEXT_DROP_DATA_DIR=.data
# CONTEXT_DROP_BASE_URL=http://localhost:8080
